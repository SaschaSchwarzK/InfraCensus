ENVIRONMENT=dev
SESSION_SECRET=change-me-in-prod-change-me-in-prod!
REQUIRE_VAULT=false
COLLECTOR_CLOCK_SKEW_MAX_SECONDS=300
SECURITY_HEADERS_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=no-referrer
SECURITY_HSTS_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

CENTRAL_CONFIG_FILE=deploy/config/central.yaml
COLLECTOR_CONFIG_FILE=deploy/config/collector.yaml
CONFIG_POLL_SECONDS=60

JOB_STATE_CLEANUP_INTERVAL_SECONDS=3600
JOB_QUEUE_JOIN_TIMEOUT_SECONDS=10
HEALTH_REQUEST_TIMEOUT_SECONDS=5
